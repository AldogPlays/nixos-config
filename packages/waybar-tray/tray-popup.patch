+
+auto Group::refresh(int signal) -> void {
+  if (drawer_signal <= 0) return;
+  if (signal == SIGRTMIN + drawer_signal) {
+    drawer_pinned = true;
+    show_group();
+  } else if (signal == SIGRTMIN + drawer_signal + 1) {
+    drawer_pinned = false;
+    hide_group();
+  }
