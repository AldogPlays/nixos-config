{
  inputs.project.url = @PROJECT_URL@;
  outputs = { project, ... }:
    let
      host = builtins.fromJSON (builtins.readFile ./project-host.json);
    in {
      nixosConfigurations.nixos = project.lib.mkPortableSystem {
        hardwareModule = ./project-hardware.nix;
        hostModule = ./project-host.nix;
        inherit (host) username homeDirectory homeStateVersion;
        packetTracerEnable = host.packetTracerEnable or false;
        themeSelection = host.themeSelection or (import (project.outPath + "/theme/selection.nix"));
      };
    };
}
